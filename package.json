{
  "name": "trading-journal",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "start": "npm run server:api & npm run client; kill $!",
    "client": "vite",
    "server": "tsx server/index.ts",
    "server:api": "API_ONLY=true PORT=43117 tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "prepare": "husky",
    "verify": "npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "express": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-helmet-async": "3.0.0",
    "react-router-dom": "7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@octokit/rest": "22.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "^9.1.7",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.3.5"
  }
}
