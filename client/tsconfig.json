{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "components": ["src/components"],
      "components/*": ["src/components/*"],
      "hooks": ["src/hooks"],
      "hooks/*": ["src/hooks/*"],
      "services": ["src/services"],
      "services/*": ["src/services/*"],
      "store": ["src/store"],
      "store/*": ["src/store/*"],
      "lib": ["src/lib"],
      "lib/*": ["src/lib/*"],
      "types": ["src/types"],
      "types/*": ["src/types/*"],
      "pages": ["src/pages"],
      "pages/*": ["src/pages/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
