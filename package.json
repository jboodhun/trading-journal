{
  "name": "trading-journal",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build": "npm run build -w client",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@octokit/rest": "22.0.1",
    "concurrently": "10.0.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0"
  }
}
